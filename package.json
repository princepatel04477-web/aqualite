{
  "name": "aqualite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "create-admin": "node scripts/create-admin.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "hero:images": "node --experimental-strip-types scripts/hero-images.ts",
    "hero:composite": "node --experimental-strip-types scripts/hero-composite.ts",
    "hero:contact-sheet": "node --experimental-strip-types scripts/hero-contact-sheet.ts",
    "preview:cf": "wrangler d1 migrations apply aqualite-store --local && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "wrangler d1 migrations apply aqualite-store --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply aqualite-store --local",
    "db:migrate:remote": "wrangler d1 migrations apply aqualite-store --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@react-email/components": "0.0.36",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "2.1.1",
    "gsap": "3.12.7",
    "jsbarcode": "^3.12.3",
    "lenis": "1.3.4",
    "motion": "12.6.3",
    "next": "^16.3.6",
    "razorpay": "2.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "4.2.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "22.13.14",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@typescript-eslint/eslint-plugin": "8.29.0",
    "@typescript-eslint/parser": "8.29.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "^16.3.6",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "vitest": "3.0.9",
    "wrangler": "^4.137.0"
  }
}
