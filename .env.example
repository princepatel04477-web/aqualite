# Server — required. The app refuses to boot if any of these are missing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Aqualite <orders@example.com>
SITE_URL=http://localhost:3000

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. "1" enables Motion+ paths. Free fallbacks ship by default.
NEXT_PUBLIC_MOTION_PLUS=0

# Optional. Set to "1" to offer Google OAuth on /login.
NEXT_PUBLIC_GOOGLE_AUTH=0

# Protects /api/cron/notify
CRON_SECRET=

# Local prototype: point SUPABASE_URL at 127.0.0.1 and use placeholder keys.
# The store then runs on the local commerce engine (real stock, cart, orders)
# so the prototype works before a Supabase project is connected.
